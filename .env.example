# Backend environment — server-side only. Never expose these in the frontend bundle.

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password

# Service-role key: full database access, bypasses RLS.
# Used only by Edge Functions and trusted server contexts (security.md section 7).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth credentials for Supabase Auth
SUPABASE_AUTH_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_GOOGLE_SECRET=your-google-client-secret
